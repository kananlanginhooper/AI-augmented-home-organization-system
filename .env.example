# Every key the code reads. Copy to .env (gitignored, mode 600) and fill in real values there.

# Database: the shared Postgres 18 server (no DB container). Same values on the laptop and the server.
DB_HOST=<server LAN address>        # empty = local SQLite file (tests only)
DB_PORT=5432
DB_NAME=home_organization_inventory
DB_USER=home_organization_inventory
DB_PASSWORD=<generated, never committed>

# Where the app lives and who may frame it
API_PORT=8109                     # provisional until the coordinator confirms the port
BIND_ADDR=127.0.0.1               # the server's LAN address there; never 0.0.0.0
PUBLIC_URL=http://localhost:8109  # later https://<app>.<domain>
UI_BASE_PATH=/
FRAME_ANCESTORS=http://localhost:8097 http://<server LAN address>:8097   # Home dashboards origins
FORWARDED_ALLOW_IPS=127.0.0.1
LOGIN=off                         # on once the IdP is live
OIDC_ISSUER=<IdP public URL>
OIDC_CLIENT_ID=<this app's client id>

# Photo storage (inside the container) and where compose mounts it from on the host
PHOTO_DIR=/data/photos
PHOTO_HOST_DIR=./data/photos

# Claude. Empty key = jobs wait for a Claude Code thread (tools/thread_jobs.py).
ANTHROPIC_API_KEY=<key, never committed>
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high                # low | medium | high | xhigh | max
AI_WORKER=on                      # off = never run jobs in the API, even with a key

# Game Plan hand-off (POST /api/tasks there). Empty URL = the "send to Game Plan" button is hidden.
GAMEPLAN_API_URL=http://<server LAN address>:8095
GAMEPLAN_API_TOKEN=<Game Plan's API_TOKEN, never committed>
GAMEPLAN_AREA=Home                # Game Plan area name for tasks sent from here
